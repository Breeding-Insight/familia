Package: Familia
Title: 'shiny' Application for Population Structure and Ancestry Assessments
Version: 1.0.4
Authors@R:
    c(
              person("Josue", "Chinchilla-Vargas",
                    role = c("aut","cre"),
                    email = "josue.chinchilla@ufl.edu"),
              person(c("Alexander", "M."), "Sandercock",
